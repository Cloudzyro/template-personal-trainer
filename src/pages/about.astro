---
import Base from "../layouts/Base.astro";
import { about, site } from "../data/site";
---

<Base title="About Imani" description="Imani Brooks is a strength coach in Fairmont Heights who has coached since 2015. Her story, qualifications and approach.">
  <header class="page-head">
    <div class="wrap">
      <h1>{about.title}</h1>
    </div>
  </header>
  <section class="section">
    <div class="wrap grid">
      <figure class="portrait">
        <svg viewBox="0 0 400 480" role="img" aria-label="Illustrated placeholder for a portrait of Imani Brooks at a squat rack">
          <rect width="400" height="480" fill="#e9eaf0"></rect>
          <rect x="60" y="40" width="14" height="440" fill="#b9bcc7"></rect>
          <rect x="326" y="40" width="14" height="440" fill="#b9bcc7"></rect>
          <rect x="40" y="150" width="320" height="8" rx="4" fill="#4a4e55"></rect>
          <rect x="22" y="118" width="22" height="72" rx="4" fill="#15171a"></rect>
          <rect x="356" y="118" width="22" height="72" rx="4" fill="#1f3fd1"></rect>
          <circle cx="200" cy="122" r="34" fill="#6b4a3a"></circle>
          <path d="M150 480 L160 230 Q200 200 240 230 L250 480 Z" fill="#15171a"></path>
          <path d="M160 232 Q130 190 120 154 L136 150 Q152 186 176 214 Z" fill="#6b4a3a"></path>
          <path d="M240 232 Q270 190 280 154 L264 150 Q248 186 224 214 Z" fill="#6b4a3a"></path>
          <rect x="0" y="440" width="400" height="40" fill="#d7d9e0"></rect>
        </svg>
        <figcaption class="mono">Replace with your own photo</figcaption>
      </figure>
      <div class="text">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <h2>Qualifications</h2>
        <ul class="creds">
          {about.credentials.map((c) => <li>{c}</li>)}
        </ul>
        <h2>How I program</h2>
        <dl class="approach">
          {
            about.approach.map((a) => (
              <div>
                <dt>{a.label}</dt>
                <dd class="mono">{a.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="actions">
          <a class="btn btn-primary" href="/apply">Apply for coaching</a>
          <a href={site.bookingUrl}>Book a free intro call</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .portrait {
    margin: 0;
  }
  .portrait svg {
    width: 100%;
    height: auto;
    border-radius: var(--r-card);
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .text {
    display: grid;
    gap: 20px;
    max-width: 40rem;
  }
  .text > p {
    color: var(--ink-2);
    font-size: 1.125rem;
  }
  .text h2 {
    font-size: 1.5rem;
    margin-top: 24px;
  }
  .creds {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    color: var(--ink-2);
  }
  .approach {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .approach div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .approach dt {
    color: var(--ink-2);
  }
  .approach dd {
    margin: 0;
    text-align: right;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 12px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 360px;
    }
  }
</style>
