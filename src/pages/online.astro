---
import Base from "../layouts/Base.astro";
import { online, programs, site } from "../data/site";
const plans = programs.find((p) => p.id === "online")!.packages;
---

<Base title="Online coaching" description="How online strength coaching with Imani Brooks works: assessment, a program in the app, weekly video review and check-ins.">
  <header class="page-head">
    <div class="wrap">
      <h1>{online.title}</h1>
      <p class="lede">{online.text}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="timeline">
        {
          online.steps.map((s, i) => (
            <li>
              <span class="mono step">Step {i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>What you need</h2>
        <ul class="needs">
          {online.needs.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="plans">
        <h2>Plans</h2>
        {
          plans.map((p) => (
            <div class="plan">
              <div>
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
              </div>
              <p class="price">
                {p.price}
                <span>{p.per}</span>
              </p>
            </div>
          ))
        }
        <div class="actions">
          <a class="btn btn-primary" href="/apply?program=Online%20coaching">Apply for online coaching</a>
          <a href={site.bookingUrl}>Book a free intro call</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .timeline {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    border-top: 2px solid var(--ink);
  }
  .timeline li {
    padding-top: 20px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .step {
    color: var(--accent-ink);
    font-size: 0.75rem;
  }
  .timeline p {
    color: var(--ink-2);
    font-size: 0.9688rem;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .needs {
    margin: 24px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 12px;
    color: var(--ink-2);
  }
  .plans {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .plan {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .plan p {
    color: var(--ink-2);
    font-size: 0.9688rem;
    margin-top: 4px;
  }
  .plan .price {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin: 0;
  }
  .price span {
    display: block;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr 1fr;
    }
    .two {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
