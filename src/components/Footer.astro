---
import { site, nav } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div>
      <p class="name">{site.name}</p>
      <p class="muted">{site.tagline}</p>
    </div>
    <div>
      <p class="head">Studio</p>
      <address>
        {site.studio.name}<br />
        {site.studio.street}<br />
        {site.studio.city}, {site.studio.region} {site.studio.postal}
      </address>
    </div>
    <div>
      <p class="head">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a><br />
      <a href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`}>{site.phone}</a>
    </div>
    <nav aria-label="Footer">
      <p class="head">Pages</p>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/apply">Apply</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <span>&copy; {year} {site.name}</span>
    <span>
      {site.social.map((s, i) => (<>{i > 0 && " · "}<a href={s.url}>{s.label}</a></>))}
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 32px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }
  .name {
    color: var(--ink);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .head {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 12px;
  }
  address {
    font-style: normal;
  }
  a {
    color: var(--ink-2);
  }
  a:hover {
    color: var(--ink);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .muted {
    color: var(--muted);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
