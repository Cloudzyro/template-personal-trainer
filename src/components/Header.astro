---
import { site, nav } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${site.name}, home`}>
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <rect x="1" y="11" width="4" height="6" rx="1" fill="currentColor"></rect>
        <rect x="6" y="7" width="4" height="14" rx="1" fill="currentColor"></rect>
        <rect x="10" y="13" width="8" height="2" fill="currentColor"></rect>
        <rect x="18" y="7" width="4" height="14" rx="1" fill="#1f3fd1"></rect>
        <rect x="23" y="11" width="4" height="6" rx="1" fill="currentColor"></rect>
      </svg>
      <span>{site.shortName}</span>
    </a>
    <nav aria-label="Main">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
      <ul id="menu" class="links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="cta"><a class="btn btn-primary" href="/apply">Apply</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const menu = document.getElementById("menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("open", !open);
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: relative;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 24px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .links a:not(.btn) {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9688rem;
    transition: color 150ms var(--ease);
  }
  .links a:not(.btn):hover,
  .links a[aria-current="page"] {
    color: var(--ink);
  }
  .links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
    text-underline-offset: 8px;
  }
  .cta .btn {
    min-height: 36px;
    padding: 0 16px;
    font-size: 0.9375rem;
  }
  .menu-btn {
    display: none;
    font: inherit;
    font-size: 0.9375rem;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    padding: 8px 12px;
    color: var(--ink);
    cursor: pointer;
  }
  @media (max-width: 820px) {
    .menu-btn {
      display: inline-flex;
    }
    .links {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .links.open {
      display: flex;
    }
    .links li a:not(.btn) {
      display: block;
      padding: 12px 0;
      font-size: 1.0625rem;
    }
    .cta {
      margin-top: 8px;
    }
    .cta .btn {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
